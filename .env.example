# Trim — Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trim_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/trim_db

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=Trim
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Seed (/api/dev/seed e /api/dev/update_dates)
# Vazio = rotas de seed desligadas (404). O segredo vai no cabeçalho X-Seed-Secret.
SEED_SECRET=
# Senha do admin de demonstração. Vazio = o seed não cria o admin.
SEED_ADMIN_PASSWORD=
# Senha do barbeiro e do cliente de demonstração. Vazio = senha aleatória, sem login.
SEED_DEMO_PASSWORD=

# Agendamento
# Fuso da barbearia: o expediente e as datas da tela são lidos nele; o banco guarda UTC.
SHOP_TIMEZONE=America/Sao_Paulo
# Antecedência mínima em minutos (0 = só proíbe o passado) e limite de dias à frente.
BOOKING_MIN_LEAD_MINUTES=0
BOOKING_MAX_DAYS_AHEAD=30
